+
+test("one2many inline creation uses settled parent context", async () => {
+    Partner._records[0].turtles = [];
+    Partner._onChanges = { foo() {} };
+    const pending = Promise.withResolvers();
+    onRpc("partner", "onchange", async ({ args }) => {
+        if (args[2].includes("foo")) {
+            await pending.promise;
+        }
+    });
+    onRpc("turtle", "onchange", ({ kwargs }) => {
+        expect(kwargs.context.default_turtle_int).toBe(14);
+        expect(kwargs.context.default_turtle_foo).toBe("soft");
+    });
+    await mountView({
+        type: "form",
+        resModel: "partner",
+        resId: 1,
+        arch: `
+            <form>
+                <field name="foo"/>
+                <field name="int_field"/>
+                <field name="turtles" context="{'default_turtle_int': int_field, 'default_turtle_foo': 'hard'}">
+                    <list editable="bottom">
+                        <control>
+                            <create string="Add soft" context="{'default_turtle_foo': 'soft'}"/>
+                        </control>
+                        <field name="turtle_int"/>
+                        <field name="turtle_foo"/>
+                    </list>
+                </field>
+            </form>`,
+    });
+    await contains("[name=foo] input").edit("pending", { confirm: false });
+    await contains("[name=int_field] input").edit("14", { confirm: false });
+    await contains(".o_field_x2many_list_row_add button").click();
+    pending.resolve();
+    await animationFrame();
+    expect(".o_data_row [name=turtle_int] input").toHaveValue("14");
+});
