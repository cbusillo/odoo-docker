@@ -12,4 +12,26 @@
 	    </xpath>
 	</t>
 
+    <t
+        t-name="muk_web_appsbar.NavBar"
+        t-inherit="web.NavBar"
+        t-inherit-mode="extension"
+    >
+        <xpath expr="//t[@t-call='web.NavBar.AppsMenu']" position="after">
+            <button
+                t-if="this.canToggleAppsBar"
+                type="button"
+                class="mk_apps_sidebar_toggle btn border-0 text-reset flex-shrink-0"
+                t-att-title="this.appsBarToggleLabel"
+                t-att-aria-label="this.appsBarToggleLabel"
+                aria-controls="mk_apps_sidebar"
+                t-att-aria-expanded="this.appsBarLayout.collapsed ? 'false' : 'true'"
+                t-att-aria-disabled="this.appsBarLayout.saving ? 'true' : 'false'"
+                t-on-click="this.toggleAppsBar"
+            >
+                <i t-att-class="this.appsBarLayout.collapsed ? 'fa fa-indent' : 'fa fa-outdent'" aria-hidden="true"/>
+            </button>
+        </xpath>
+    </t>
+
 </templates>
