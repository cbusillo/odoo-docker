diff --git a/muk_web_appsbar/static/src/webclient/layout/layout.js b/muk_web_appsbar/static/src/webclient/layout/layout.js
index 1dc0701..d5a32ae 100644
--- a/muk_web_appsbar/static/src/webclient/layout/layout.js
+++ b/muk_web_appsbar/static/src/webclient/layout/layout.js
@@ -1,5 +1,10 @@
+import { proxy } from "@odoo/owl";
+import { _t } from "@web/core/l10n/translation";
+import { user } from "@web/core/user";
+import { useService } from "@web/core/utils/hooks";
 import { patch } from '@web/core/utils/patch';
 
+import { NavBar } from "@web/webclient/navbar/navbar";
 import { WebClient } from '@web/webclient/webclient';
 import { AppsBar } from '@muk_web_appsbar/webclient/appsbar/appsbar';
 
@@ -10,3 +15,49 @@ patch(WebClient, {
         AppsBar,
     },
 });
+
+const LARGE = "mk_sidebar_type_large";
+const SMALL = "mk_sidebar_type_small";
+
+patch(NavBar.prototype, {
+    setup() {
+        super.setup(...arguments);
+        this.appsBarOrm = useService("orm");
+        this.appsBarNotification = useService("notification");
+        this.appsBarLayout = proxy({
+            collapsed: document.body.classList.contains(SMALL),
+            saving: false,
+        });
+    },
+    get canToggleAppsBar() {
+        return document.body.classList.contains(LARGE) || document.body.classList.contains(SMALL);
+    },
+    get appsBarToggleLabel() {
+        return this.appsBarLayout.collapsed ? _t("Expand AppsBar") : _t("Collapse AppsBar");
+    },
+    setAppsBarCollapsed(collapsed) {
+        document.body.classList.toggle(LARGE, !collapsed);
+        document.body.classList.toggle(SMALL, collapsed);
+        this.appsBarLayout.collapsed = collapsed;
+    },
+    async toggleAppsBar() {
+        if (this.appsBarLayout.saving) {
+            return;
+        }
+        const wasCollapsed = this.appsBarLayout.collapsed;
+        this.appsBarLayout.saving = true;
+        this.setAppsBarCollapsed(!wasCollapsed);
+        try {
+            await this.appsBarOrm.write("res.users", [user.userId], {
+                sidebar_type: wasCollapsed ? "large" : "small",
+            });
+        } catch {
+            this.setAppsBarCollapsed(wasCollapsed);
+            this.appsBarNotification.add(_t("Could not save the AppsBar layout."), {
+                type: "warning",
+            });
+        } finally {
+            this.appsBarLayout.saving = false;
+        }
+    },
+});
diff --git a/muk_web_appsbar/static/src/webclient/layout/layout.xml b/muk_web_appsbar/static/src/webclient/layout/layout.xml
index 7fca9b6..4eac8e8 100644
