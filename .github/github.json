{
  "defaultBranch": "main",
  "projectType": "odoo-base-runtime-image",
  "docs": {
    "index": "README.md",
    "agents": "AGENTS.md",
    "dockerfile": "Dockerfile",
    "scripts": "scripts",
    "overallDirection": "https://github.com/cbusillo/direction/blob/HEAD/DIRECTION.md",
    "githubConfigSchema": "https://github.com/cbusillo/codex-skills/blob/main/skills/github/references/config-schema.md",
    "executingLoop": "https://github.com/cbusillo/codex-skills/blob/main/skills/references/executing-loop.md",
    "modelReview": "https://github.com/cbusillo/codex-skills/blob/main/skills/references/model-review.md",
    "launchplaneBoundary": "https://github.com/cbusillo/codex-skills/blob/main/skills/launchplane/SKILL.md#runtime-authority-boundary",
    "mergeTrain": "https://github.com/cbusillo/codex-skills/blob/main/skills/launchplane/references/merge-train.md"
  },
  "qualityGate": {
    "json": {
      "metadata": "jq empty .github/github.json"
    },
    "build": {
      "runtime": "docker build -t ghcr.io/cbusillo/odoo-docker:19.0-runtime --target runtime .",
      "devtools": "docker build -t ghcr.io/cbusillo/odoo-docker:19.0-devtools --target runtime-devtools ."
    },
    "smoke": {
      "runtime": "bash scripts/smoke-runtime.sh <image-reference>",
      "devtools": "bash scripts/smoke-devtools.sh <image-reference>",
      "smokeDbInit": "bash scripts/smoke-db-init.sh <image-reference>",
      "downstreamHelpers": "bash scripts/test-downstream-helpers.sh <image-reference>",
      "dependencyHealth": "bash scripts/test-image-dependency-health.sh",
      "odooBinWrapper": "bash scripts/test-odoo-bin-wrapper.sh",
      "requirementsOverrides": "bash scripts/test-check-requirements-overrides.sh"
    },
    "lint": {
      "dockerfile": "docker run --rm -v \"$PWD:/work:ro\" -w /work hadolint/hadolint:v2.14.0 hadolint Dockerfile"
    },
    "inspection": {
      "ide": "PyCharm",
      "scopePreference": [
        "changed_files",
        "directory",
        "whole_project"
      ],
      "prepare": {
        "python": {
          "version": "3.13",
          "moduleName": "odoo-docker",
          "sync": true,
          "requiredGeneratedState": [
            ".venv",
            ".idea"
          ]
        }
      }
    },
    "docsRequiredWhen": [
      "behavior changes",
      "api changes",
      "config changes",
      "operations changes",
      "ownership boundaries change",
      "Dockerfile changes",
      "image contract changes",
      "downstream helper behavior changes",
      "self-hosted runner or cache behavior changes",
      "workflow publishing changes"
    ]
  },
  "importantWorkflows": [
    "Build And Publish Images",
    "GHCR Retention",
    "Runner Health",
    "CodeQL",
    "Dependency Graph",
    "Dependabot Updates"
  ],
  "prWorkflow": {
    "mergePath": "launchplane-merge-train",
    "mergeMethod": "merge",
    "handoffComment": "Ready for the merge train",
    "handoff": "When the execution brief assigns a direction-session handoff, leave labeling and train driving to that session; otherwise follow the merge-train workflow.",
    "watchSkill": "babysit-pr",
    "modelReviewIsAdvisory": true,
    "requiredStatusChecks": [
      "image-verification"
    ],
    "branchProtection": {
      "strictStatusChecks": true,
      "requiredApprovingReviewCount": 0,
      "enforceAdmins": true
    },
    "codeScanningMergeProtection": {
      "ruleset": "Require code scanning results",
      "tool": "CodeQL",
      "alertsThreshold": "errors",
      "securityAlertsThreshold": "high_or_higher"
    }
  },
  "relatedRepos": [
    "odoo-enterprise-docker",
    "odoo-devkit",
    "odoo-shared-addons",
    "launchplane"
  ],
  "launchplane": {
    "enabled": true,
    "mergeTrain": {
      "enabled": true,
      "controller": true,
      "readyLabel": "ready-to-merge",
      "baseBranch": "main"
    }
  },
  "githubSignals": {
    "postMerge": {
      "waitForActions": true,
      "checkSecurityAndQuality": true
    },
    "capabilities": {
      "codeScanning": "available",
      "secretScanning": "available",
      "dependabotAlerts": "available",
      "securityAdvisories": "available"
    },
    "refreshWhen": [
      "repo visibility changes",
      "GitHub plan changes",
      "security settings change",
      "token permissions change"
    ]
  },
  "cleanup": {
    "deleteMergedLocalBranches": true,
    "removeMergedCleanWorktrees": true
  },
  "githubSettings": {
    "expected": {
      "deleteBranchOnMerge": true
    }
  },
  "metadataFreshness": {
    "updateWhen": [
      "docs routing changes",
      "validation gates change",
      "primary commands change",
      "important workflows change",
      "repo relationship changes",
      "Launchplane routing changes",
      "merge path changes",
      "branch protection or rulesets change",
      "cleanup policy changes",
      "ownership boundaries change",
      "Dockerfile changes",
      "image contract changes",
      "workflow publishing changes",
      "self-hosted runner or cache behavior changes"
    ]
  }
}
